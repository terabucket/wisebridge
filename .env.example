# ─── OpenAI (required) ───────────────────────────────────────────
# Server-side only — never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-...
# Optional: model used for chat, requirement specs and deliverables.
OPENAI_MODEL=gpt-5-mini

# ─── Stripe (optional) ───────────────────────────────────────────
# Leave empty to run checkout in DEMO mode (payment is simulated).
# Use sk_test_... keys while testing, sk_live_... in production.
STRIPE_SECRET_KEY=

# ─── Site ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── SEO (optional) ──────────────────────────────────────────────
# Verification codes from Google Search Console / Bing Webmaster Tools
# (HTML-tag method: paste only the content="..." value).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
